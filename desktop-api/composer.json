{
  "name": "stellarsecurity/desktop-vpn-api",
  "description": "Isolated Stellar Desktop API v2",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "12.69.0",
    "stellarsecurity/user-laravel": "1.0.5"
  },
  "autoload": {
    "psr-4": {
      "Stellar\\DesktopApi\\": "app/"
    }
  },
  "scripts": {},
  "extra": {
    "laravel": {
      "dont-discover": [
        "*"
      ]
    }
  },
  "config": {
    "allow-plugins": false,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
