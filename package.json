{
  "name": "stellar-vpn-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4176 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4177 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:api": "node --test tests/api/*.test.mjs",
    "test:api:v2": "php -n desktop-api/tests/run.php",
    "test:api:v2:http": "env -u WEBSITE_SITE_NAME APP_ENV=testing APP_URL=http://127.0.0.1 STELLAR_API_MODE=fixture php desktop-api/tests/http.php",
    "test:api:v2:identity": "env APP_ENV=testing php desktop-api/tests/identity.php",
    "check:api:v2": "node scripts/check-api-v2.mjs",
    "dev:test-api": "node scripts/test-api/server.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "tauri": "node scripts/desktop.mjs",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": { "esbuild": "0.28.1" }
}
